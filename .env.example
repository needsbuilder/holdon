# Copy to .env and adjust. Nothing here is required for local use.
# Start with:  node --env-file=.env dist/index.js

# Where to listen. Keep 127.0.0.1 unless you put a TLS proxy in front.
HOLDON_HOST=127.0.0.1
PORT=8787

# Base URL used in approval links sent to the trusted contact.
# HOLDON_PUBLIC_URL=https://holdon.example.org

# Extra hostnames allowed in the Host header and as browser origins (comma separated).
# HOLDON_ALLOWED_HOSTS=holdon.example.org
# HOLDON_ALLOWED_ORIGINS=simulator.example.org

# SQLite file. Defaults to ./data/holdon.db
# HOLDON_DB=./data/holdon.db

# Key that signs approval links and webhook bodies. If unset, a random key is
# generated once and stored next to the database (data/secret.key).
# HOLDON_SECRET=

# Optional: POST every hold event to this URL (JSON, signed with X-HoldOn-Signature).
# HOLDON_WEBHOOK_URL=

# The server prints each new hold's signed approval link to its log, so the demo
# works with only a browser. Set to 0 anywhere logs are shared.
# HOLDON_LOG_APPROVAL_LINKS=0

# Seed file for "npm run seed". Defaults to seed/demo-circle.json
# HOLDON_SEED_FILE=
